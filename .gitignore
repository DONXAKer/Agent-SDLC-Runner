node_modules/
dist/
*.log
*.tsbuildinfo
.runner-state/
config/projects/*.local.json
config/runner.local.json

# IDE
.idea/
.vscode/

# Пути хоста для docker-compose: принадлежат машине, а не репозиторию.
.env

# Сырые записи замеров моделей: принадлежат машине оператора, не проекту.
docs/*.local.md

# Снимки бенчмарка — полные копии рабочих деревьев конкретной машины, их не версионируем.
# Результаты прогонов (bench/results/) версионируются: журнал docs/model-runs.md ссылается
# на их отчёты, и без них вердикты по моделям не перепроверяемы.
bench/snapshots/
# Трассы прогонов (лента событий, сырые запросы к модели): мегабайты транскриптов
# конкретной машины. Отчёты в bench/results/ версионируются, трассы — нет.
bench/traces/
docker-compose.override.yml

# Временные копии семейств для контроля эталона на решении (bench/specs/_conventions.md):
# решения задач в репозиторий не попадают никогда.
bench/.tmp/
