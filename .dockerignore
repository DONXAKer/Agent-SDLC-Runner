# Зависимости ставятся внутри образа: node_modules с хоста несёт бинарники под другую
# платформу, и на arm64-хосте с amd64-образом (или наоборот) это тихо ломается на первом
# нативном модуле.
node_modules
**/node_modules

dist
**/dist
.git
.idea

# Локальные конфиги проектов не попадают в слой образа: конфиг приходит томом, а
# `projects/*.local.json` может содержать пути и бюджеты конкретной машины.
config/projects/*.local.json

Dockerfile
docker-compose.yml
.dockerignore
.env
