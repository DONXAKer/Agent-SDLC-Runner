+/**
+ * Таблица зон: зона и ставка в рублях за килограмм. Ставки — целые рубли (см. tariffs.ts).
+ *
+ * С флагом `--zone <name>` печатается только строка названной зоны; зоны, которой нет в
+ * тарифах, — не ошибка, а пустой результат: строка «ничего не найдено», код выхода обычный
+ * (поддержка вводит имена руками, падение с трассой на опечатке ей не помощник).
+ */
+function listCommand(flags: Record<string, string | true>): string {
+  const zoneFlag = flags['zone'];
+  const rows = ZONES.filter((zone) => (typeof zoneFlag === 'string' ? zone === zoneFlag : true));
+  if (rows.length === 0) {
+    return 'ничего не найдено';
+  }
+  return formatTable(rows.map((zone) => [zone, RATE_PER_KG[zone] / 100]));
 }
 
