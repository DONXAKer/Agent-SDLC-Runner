+
+/** Единственное правило округления для обоих расчётов. */
+function roundWeightG(rawG: number): number {
   return Math.ceil(rawG / WEIGHT_STEP_G) * WEIGHT_STEP_G;
 }
+
+/** Утверждённый приёмкой коэффициент применяется до округления. */
+const PACKING_FACTOR = 1.2;
+
+export function packedWeightG(dimensionsCm: DimensionsCm): number {
+  const [length, width, height] = dimensionsCm;
+  return roundWeightG(((length * width * height) / 5) * PACKING_FACTOR);
+}
