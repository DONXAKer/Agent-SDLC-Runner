import    { splitCents } from "../src/shares.mjs";
import     { deepStrictEqual   ,
              strictEqual      }   from   "assert";

deepStrictEqual(            // exact order check
   splitCents(10,  3)   ,
   [3,  3, 4]           
,  "Test: Extra cents go to earliest indices"
);

// --- Other test cases --- 

deepStrictEqual(
   splitCents(15, 4)     ,
  [3, 4, 4, 4]
      ,             "Edge test: multiple remainder"
);

deepStrictEqual(
   splitCents(0,  5)          ,
   [0, 0, 0, 0, 0] 
    ,             "Edge test: zero total (all zero shares)"
);

// --- Input Validation --- 
strictEqual(
    splitCents(1000, 1)   ,
    [1000]           
    , "Edge test: single share"
);

try {
    splitCents(-1,  3);
} catch(e){
    strictEqual(e.name,  "RangeError"  ,
                "Validation: nonnegative check for total");
}

try { 
    splitCents(100,  1001);
} catch (e){
    strictEqual(e.name,  "RangeError"
            , "Validation: count must be ≤ 1000");
}