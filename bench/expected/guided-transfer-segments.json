      "exists": "test/additional.test.mjs"
    },
    {
      "id": "RPreserve",
      "category": "regression",
      "claim": null,
      "description": "Existing checks and public entry are unchanged",
      "preserve": [
        "src/index.ts",
        "test/existing.test.mjs",
