  ],
  "referenceFiles": {
    "core/key.mjs": "import { splitKey } from './segments.mjs';\nexport function normalizeKey(value) {\n  return splitKey(value).join(':');\n}\n",
    "core/segments.mjs": "export function splitKey(value) {\n  if (typeof value !== 'string') throw new TypeError('key must be a string');\n  return value.split('/').filter(part => part !== '');\n}\n",
    "test/additional.test.mjs": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { normalizeKey } from '../src/index.ts';\ntest('new behavior',()=>{assert.deepEqual(normalizeKey(...[\"/Alpha//Beta/\"]),\"Alpha:Beta\");assert.deepEqual(normalizeKey(...[\"///\"]),\"\");assert.deepEqual(normalizeKey(...[\".././ x \"]),\"..:.: x \");});\n"
  }
