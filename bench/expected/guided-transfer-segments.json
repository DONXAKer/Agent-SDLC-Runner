        "fn": "normalizeKey",
        "args": [
          "/Alpha//Beta/"
        ]
      },
      "expect": "Alpha:Beta"
    },
    {
      "id": "Pr2",
      "category": "precision",
      "claim": "claim-1",
      "description": "normalizeKey: Pr2",
      "call": {
        "fn": "normalizeKey",
        "args": [
          "///"
        ]
      },
      "expect": ""
    },
    {
      "id": "Pr3",
      "category": "precision",
      "claim": "claim-1",
      "description": "normalizeKey: Pr3",
      "call": {
        "fn": "normalizeKey",
        "args": [
          ".././ x "
        ]
      },
      "expect": "..:.: x "
    },
    {
      "id": "Pr4",
      "category": "precision",
